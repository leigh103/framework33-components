<script src="/js/moment.js?v=2.29.2"></script>
<script src="/js/components/widget-core.js"></script>
<script src="/js/components/thumbnail.js"></script>
<script>

        window.sendMessageModalConfig = {
            title: 'Send Message',
            closeOnOverlay: true,
            customClass: 'medium',
            inputs: [
                {name:'content', label:'Message', input_type:'textarea'}
            ],
            buttons: {
                cancel: true,
                ok: 'Send'
            }
        }

        extend.profile = function(){

            methods.sendMessage = function (new_message) {

                modal.closeAll()
                modal.openTemplate('sendMessage').then(result => {

                    let payload = {
                        to: '<%- record._id %>',
                        subject: result.data.subject,
                        content: result.data.content
                    }
        
                    http.post('/api/notification/send', payload).then((data) => {
                        methods.notify('Sent!')
                    }).catch((e) => {
                        methods.error(e,'error')
                    })
                })

            }

            methods.getFeed = async () => {
                let feed = await http.post('/api/social_posts/get-posts',{_parent: '<%- record._id %>'})
                for (var post of feed){

                    if (post.gallery && post.gallery.length > 0){

                        post._gallery = '<div class="gallery">'

                        for (var img of post.gallery){
                            post._gallery += `<img src="${img.small}">`
                        }

                        post._gallery += '</div>'

                    }
                    
                }

                scope.feed = feed
            }

            methods.follow = async () => {
                http.post('/api/social_users/follow',{_id: '<%- record._id %>'}).then((data)=>{

                    let follow = document.querySelector('#follow'),
                        unfollow = document.querySelector('#unfollow')

                    if (follow){
                        follow.classList.toggle('bg-primary')
                        follow.classList.toggle('outline-primary')
                        if (follow.innerHTML == 'Unfollow'){
                            follow.innerHTML = 'Follow'
                        } else {
                            follow.innerHTML = 'Unfollow'
                        }
                    }

                    if (unfollow){
                        unfollow.classList.toggle('outline-primary')
                        unfollow.classList.toggle('bg-primary')
                        if (unfollow.innerHTML == 'Unfollow'){
                            unfollow.innerHTML = 'Follow'
                        } else {
                            unfollow.innerHTML = 'Unfollow'
                        }
                    }
                    
                    methods.notify()

                }).catch((e)=>{
                    methods.error(e)
                })
            }

            methods.subscribe = async () => {
                http.post('/api/social_users/subscribe',{_id: '<%- record._id %>'}).then((data)=>{
                    methods.notify()
                }).catch((e)=>{
                    methods.error(e)
                })
            }

            scope.feed = []
            methods.getFeed()

        }

    </script>

