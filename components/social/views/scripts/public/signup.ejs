<script src="/js/framework-33/v3.0/framework33.js?v=3"></script>
<script src="/js/moment.js?v=2.29.2"></script>
<script src="/js/components/widget-core.js"></script>
<script src="/js/components/thumbnail.js"></script>

<%- include(basedir+'/themes/default/views/pages/authentication/partials/bot_protection.ejs') %>

    <script>

        extend.account = function(){

            scope.record = {}

            methods.signUp = function(){

                errorField()

                if (!scope.record.username){
                    errorField('username','Please specify a username')
                    return
                } else if (!scope.record.email){
                    errorField('password','Please specify your email address')
                    return
                } else if (!scope.record.password){
                    errorField('password','Please specify a password')
                    return
                } else if (!scope.record.password_confirmation){
                    errorField('password_confirmation','Please confirm your password')
                    return
                } else if (scope.record.password_confirmation != scope.record.password){
                    errorField('password',"Passwords don't match, please try again")
                    return
                } else if (!scope.record._dob){
                    errorField('dob',"Passwords set your date of birth")
                    return
                }

                if (scope.record._dob){
                    scope.record.dob = new Date(scope.record._dob).toISOString()
                }

                scope.record.fp = document.getElementById('fp').value

                if (!/[a-z0-9]{32}/.test(scope.record.fp)){
                    methods.error('Bot protection activated')
                    return false
                }
                console.log(scope.record)

                http.post('/sign-up', scope.record).then((data) => {
                    modal.create({
                        title: 'Notification',
                        content: 'Welcome! Click below to login',
                        customClass: 'notify',
                        buttons: {
                            cancel: false,
                            ok: false,
                            custom:[
                                {
                                    text: 'Login',
                                    href: '/login',
                                    class: 'btn bg-primary'
                                }
                            ]
                        }
                    })
                }).catch((e)=>{
                    console.log('err ',e)
                    methods.error(e)
                })

            }

        }

    </script>

