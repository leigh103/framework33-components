
    <section class="page profile gallery">
        <div class="contain py-1">
            <h1><%- model.data.username %>'s Gallery</h1>
            <div class="grid col-12 gap-1">

                <% if (typeof gallery != 'undefined' && gallery.length > 0){ %>

                    <% gallery.forEach((img, i) => { %>
                        <div class="img-wrapper colspan-3 colspan-m-4 colspan-s-6" data-index="<%- i %>">
                            <img src="<%- img.small %>">
                        </div>
                    <% }) %>

                <% } %>
            </div>
        </div>
    </section>

    <% if (typeof gallery != 'undefined' && gallery.length > 0){ %>

    <style>
        .gallery .img-wrapper { cursor: pointer; }
        .gallery .img-wrapper img { width: 100%; height: 100%; object-fit: cover; display: block; }
    </style>

    <dialog class="gallery-lightbox" id="gallery-lightbox" data-images="<%- JSON.stringify(gallery.map(img => ({ small: img.small, large: img.large || img.small }))).replace(/"/g, '&quot;') %>">
        <button class="lightbox-close">&times;</button>
        <button class="lightbox-prev">&#8249;</button>
        <img class="lightbox-img" src="">
        <button class="lightbox-next">&#8250;</button>
    </dialog>

    <script>
        (function () {
            const lightbox    = document.getElementById('gallery-lightbox')
            const lightboxImg = lightbox.querySelector('.lightbox-img')
            const images      = JSON.parse(lightbox.dataset.images.replace(/&quot;/g, '"'))
            let index = 0

            function open(i) {
                index = i
                lightboxImg.src = images[i].large
                lightbox.showModal()
            }

            function nav(dir) {
                index = (index + dir + images.length) % images.length
                lightboxImg.src = images[index].large
            }

            // open on thumbnail click
            document.querySelectorAll('.gallery .img-wrapper').forEach(el => {
                el.addEventListener('click', () => open(parseInt(el.dataset.index)))
            })

            lightbox.querySelector('.lightbox-close').addEventListener('click', () => lightbox.close())
            lightbox.querySelector('.lightbox-prev').addEventListener('click', () => nav(-1))
            lightbox.querySelector('.lightbox-next').addEventListener('click', () => nav(1))

            // click away
            lightbox.addEventListener('click', (e) => { if (e.target === lightbox) lightbox.close() })

            // keyboard
            lightbox.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft')  nav(-1)
                if (e.key === 'ArrowRight') nav(1)
            })

            // touch swipe
            let touchStartX = 0
            lightbox.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX }, { passive: true })
            lightbox.addEventListener('touchend', (e) => {
                const delta = e.changedTouches[0].clientX - touchStartX
                if (delta > 50)       nav(-1)
                else if (delta < -50) nav(1)
            })
        })()
    </script>

    <% } %>
