
    <% if (record.background){ %> 
    <section class="page hero">
        <div class="background" style="background-image: url('<%- record.background.medium %>')"></div>
    </section>
    <% } %>
    <section class="page">
        <div class="contain py-1">
            <thumb-nail name="<%- record.username %>" <% if (typeof avatar != 'undefined'){ %>src="<%- record.avatar.small %>"<% } %>></thumb-nail>
            <h1><%- record.username %></h1>
            <div><%- moment(Date.now()).diff(record.dob, 'years') %></div>
            <div><%- record.gender %></div>

            <button class="btn mt-2 bg-primary" app-click="sendMessage()">Message</button>

            <div class="mt-2"><%- record.description %></div>
        </div>
    </section>

