<a href="/profile/<%- username %>" class="profile" <% if (typeof background != 'undefined'){ %>style="background-image: url(<%- background.small %>)"<% } %>>
    <div class="details">
        <thumb-nail name="<%- username %>" <% if (typeof avatar != 'undefined'){ %>src="<%- avatar.small %>"<% } %> data-size="4rem"></thumb-nail>
        <h2><%- username %></h2>
        <div class="font-small capitalise"><% if (typeof gender != 'undefined'){ %><%- gender %><% } %> <% if (typeof dob != 'undefined'){ %><%- moment(Date.now()).diff(dob, 'years') %><% } %></div>
    </div>

</a>